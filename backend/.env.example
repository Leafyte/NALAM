# Copy to .env and fill in. NEVER commit .env. Placeholders only below.

# --- Database (SQLite file for the prototype) ---
HEALTH_DB_PATH=./data/health.db

# --- Clinician interface (HTTP Basic auth). Leave password EMPTY to keep it disabled. ---
CLINICIAN_USERNAME=clinician
CLINICIAN_PASSWORD=

# --- Speech-to-text: none | openai | local | indicconformer_http | mock ---
STT_PROVIDER=none
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
LOCAL_WHISPER_MODEL=small
INDICCONFORMER_URL=
INDICCONFORMER_API_KEY=
# IndicConformer has no English. Use a different provider for English speech: none | openai | local | mock
STT_ENGLISH_PROVIDER=none
STT_LOW_CONFIDENCE=0.6

# --- Translation: none | google | indictrans2_http | mock ---
TRANSLATION_PROVIDER=none
GOOGLE_TRANSLATE_API_KEY=
INDICTRANS2_URL=
INDICTRANS2_API_KEY=

# --- CORS (only matters for Expo Web) ---
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
