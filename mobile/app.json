{
  "expo": {
    "name": "Nalam",
    "slug": "nalam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAllowsLocalNetworking": true
      },
      "bundleIdentifier": "com.nalam.healthassistant"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nalam.healthassistant",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Nalam to use the microphone so you can answer intake questions by voice in your native language."
        }
      ]
    ],
    "scheme": "nalam",
    "extra": {
      "note": "Set EXPO_PUBLIC_API_URL to your HTTPS backend for production builds. See README."
    }
  }
}